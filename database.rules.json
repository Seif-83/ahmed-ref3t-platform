{
  "rules": {
    ".read": false,
    ".write": false,
    "platform_content": {
      ".read": true,
      ".write": "auth != null && auth.token.role == 'admin'"
    },
    "site_settings": {
      ".read": true,
      ".write": "auth != null && auth.token.role == 'admin'"
    },
    "students": {
      ".read": true,
      ".write": true,
      ".indexOn": ["phone"]
    },
    "student_unlocks": {
      ".read": true,
      ".write": true
    },
    "exams": {
      ".read": true,
      ".write": "auth != null && auth.token.role == 'admin'"
    },
    "exam_results": {
      ".read": true,
      ".write": true
    }
  }
}